  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\IA\OSS\IANet\dev\build-ninja\sandbox && "C:\Program Files\CMake\bin\cmake-gui.exe" -SC:\IA\OSS\IANet\dev -BC:\IA\OSS\IANet\dev\build-ninja"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build sandbox/edit_cache: phony sandbox/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build sandbox/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\IA\OSS\IANet\dev\build-ninja\sandbox && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SC:\IA\OSS\IANet\dev -BC:\IA\OSS\IANet\dev\build-ninja"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build sandbox/rebuild_cache: phony sandbox/CMakeFiles/rebuild_cache.util

